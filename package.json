{
  "name": "company-audit",
  "version": "1.0.0",
  "private": true,
  "description": "A template for outside-in company audit sites: one company, one role, public by default, with a key-gated prep layer.",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p ${PORT:-3000}",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "validate": "tsx --conditions=react-server scripts/validate.ts",
    "logos": "tsx scripts/logos.ts",
    "verify:share": "tsx --conditions=react-server scripts/verify-share.ts",
    "lighthouse": "lhci autorun",
    "check": "npm run validate && npm run typecheck && npm run lint"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@xyflow/react": "^12.12.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "geist": "^1.7.2",
    "lucide-react": "^1.49.0",
    "next": "^15.5.27",
    "radix-ui": "^1.6.7",
    "react": "19.1.9",
    "react-dom": "19.1.9",
    "server-only": "^0.0.1",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@lhci/cli": "^0.15.1",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.27",
    "node-vibrant": "^4.0.4",
    "playwright-core": "^1.63.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "5.8.3",
    "typescript-eslint": "^8.71.0"
  }
}
