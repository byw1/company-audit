# `npm run prep:init` writes PREP_KEY to .env.local for you. Never commit
# .env.local. Your host needs none of this: deploys take no variables.

# The only key to your prep. It seals content/prep.ts into
# content/prep.sealed.json, and visiting any page once with ?prep=<PREP_KEY>
# unlocks the prep view. Only you hold it; keep it in your password manager.
PREP_KEY=

# Optional, local: where your evidence file lives, if content/author.md points to it.
MASTER_CONTEXT_PATH=
