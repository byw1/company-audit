# `npm run prep:init` writes PREP_KEY and PREP_SECRET to .env.local for you.
# Never commit .env.local. Set the same two values as secrets on your host.

# The prep key. Visit any page with ?prep=<PREP_KEY> once to unlock the prep view.
PREP_KEY=

# Decrypts content/prep.sealed.json. 32 random bytes, base64url. Anyone with
# this and the repo can read your prep, so treat it like a password.
PREP_SECRET=

# Optional: the absolute URL the site is served from, for link previews on a
# custom domain. Railway's RAILWAY_PUBLIC_DOMAIN is used automatically.
NEXT_PUBLIC_SITE_URL=

# Optional: where your evidence file lives, if content/author.md points to it.
MASTER_CONTEXT_PATH=
