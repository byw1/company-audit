# Copy to .env.local for local development. Never commit the real file.

# The prep key. Visit any page with ?prep=<PREP_KEY> once to unlock the prep view.
# Locally, with no key set, ?prep=dev works.
PREP_KEY=

# Optional: the absolute URL the site is served from, for link previews.
# On Railway, RAILWAY_PUBLIC_DOMAIN is used automatically.
NEXT_PUBLIC_SITE_URL=

# Optional: where /new-audit finds your master context file (never committed).
MASTER_CONTEXT_PATH=
