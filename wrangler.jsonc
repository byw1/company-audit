{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Rename this per audit: it becomes <name>.<your-subdomain>.workers.dev.
  "name": "company-audit",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    // Self-reference, required by OpenNext; must match "name" above.
    { "binding": "WORKER_SELF_REFERENCE", "service": "company-audit" }
  ],
  "observability": { "enabled": true }
  // No secrets or variables: the sealed prep ships in the build, and only the
  // key you bring (?prep=<PREP_KEY>) opens it.
}
